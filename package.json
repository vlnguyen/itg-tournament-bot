{
  "name": "itg-tournament-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy --schema packages/server/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/server/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/server/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/server/prisma/schema.prisma",
    "db:init:rebuild": "packages/server/prisma/rebuild-init-migration.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "prisma": "^6.1.0"
  }
}
