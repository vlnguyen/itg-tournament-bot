# Local development. Port 5433 avoids clashing with a system Postgres on 5432.
DATABASE_URL="postgresql://itg:itg@localhost:5433/itg?schema=public"

# Discord — see DESIGN.md, Deployment
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URL=
SESSION_SECRET=
ADMIN_DISCORD_IDS=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Production only — the domain Caddy issues a cert for and reverse-proxies
# to the app. Unused locally (the `caddy` compose service only starts under
# `--profile production`).
PUBLIC_DOMAIN=
