# Production template — copy this to `.env` on the VM (never commit the
# real file) and fill in the blanks. Create it by hand over SSH; it should
# never pass through git, GitHub Actions, or this repo's history.

# Ignored by the `app` service in production — docker-compose.yml's
# DATABASE_URL override (postgres:5432, the in-network hostname) always
# wins. Left here only so the app doesn't fail its startup env-schema
# check if something ever reads this key directly; any value is fine.
DATABASE_URL="postgresql://itg:itg@postgres:5432/itg?schema=public"

# The PRODUCTION Discord application's bot token — a separate app from
# whatever you use for local dev. See DESIGN.md, Deployment.
DISCORD_TOKEN=

# Same production Discord application's OAuth2 tab.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must exactly match a redirect URI registered on that application's
# OAuth2 → Redirects page — Discord requires an exact string match.
DISCORD_OAUTH_REDIRECT_URL=https://REPLACE_WITH_YOUR_DOMAIN/api/auth/callback

# Cookie signing key. Generate a real random value, e.g.:
#   openssl rand -hex 32
# Rotating this is the global-logout mechanism — don't reuse the dev value.
SESSION_SECRET=

# Comma-separated Discord user IDs granted Bot Administrator at boot.
ADMIN_DISCORD_IDS=

# The public URL the web app is actually served at — used for links
# Discord messages send back into the web UI.
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN

PORT=3000

# The domain Caddy requests a Let's Encrypt cert for and reverse-proxies
# to the app. Must already point (A record) at this VM's public IP before
# the `caddy` service starts, or certificate issuance will fail.
PUBLIC_DOMAIN=REPLACE_WITH_YOUR_DOMAIN

# Only needed if you want a non-default Postgres password in production
# (docker-compose.yml falls back to "itg" if unset — fine for a
# single-VM deployment with no external DB access, but you may prefer
# to set a real one here regardless).
POSTGRES_PASSWORD=
